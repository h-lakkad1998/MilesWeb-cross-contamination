add_action('admin_menu',function(){
    add_options_page('Settings','Settings','manage_options','crisp-beacon-settings',function(){
        echo '<div class="wrap"><h1>Settings</h1><form method="post" action="options.php">';
        settings_fields('crisp-beacon_group');
        do_settings_sections('crisp-beacon-settings');
        submit_button();
        echo '</form></div>';
    });
});
add_action('admin_init',function(){
    register_setting('crisp-beacon_group','crisp-beacon_options');
    add_settings_section('crisp-beacon_main','Configuration',function(){echo '<p>Configure options below.</p>';},'crisp-beacon-settings');
    add_settings_field('crisp-beacon_cache','Cache Mode',function(){
        $o=get_option('crisp-beacon_options',array());$v=isset($o['cache'])?$o['cache']:'enabled';
        echo '<select name="'.esc_attr('crisp-beacon_options[cache]').'"><option value="enabled"'.selected($v,'enabled',false).'>Enabled</option><option value="disabled"'.selected($v,'disabled',false).'>Disabled</option></select>';
    },'crisp-beacon-settings','crisp-beacon_main');
});
if(function_exists('add_shortcode'))add_shortcode('crisp_beacon_stats',function(){
    $o=get_option('crisp-beacon_options',array());
    return '<!-- stats: '.(isset($o['cache'])?$o['cache']:'none').' -->';
});
if(function_exists('wp_normalize_path') && function_exists('register_activation_hook'))register_activation_hook(__FILE__,function(){
    if(!get_option('crisp-beacon_options'))add_option('crisp-beacon_options',array('cache'=>'enabled','version'=>'1.0'));
});

}
